NODE_ENV=development
PORT=3000

# Base de donnees MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=eikpet
DB_PASSWORD=changeme
DB_NAME=eikpet

# JWT
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Stockage documents (dossier local servi via Nginx en prod)
DOCUMENTS_STORAGE_PATH=./storage/documents
PHOTOS_STORAGE_PATH=./storage/photos

# Firebase Cloud Messaging (notifications push)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Brevo (envoi d'emails transactionnels : reinitialisation de mot de passe)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@eikpet.fr
BREVO_SENDER_NAME=EikPet

# RevenueCat (abonnements) : secret partage configure dans le dashboard RevenueCat
# pour authentifier les appels au webhook POST /webhooks/revenuecat
REVENUECAT_WEBHOOK_SECRET=changeme-revenuecat-webhook-secret
